# Konfiguration des Docker-Compose-Stacks. Als .env kopieren und ausfuellen:
#   cp .env.example .env

# --- Pflichtangaben - ohne sie startet der Stack nicht -----------------------------------------

# Geteiltes Geheimnis zwischen JARVIS-AIService und JARVIS-MCP. Derselbe Wert muss auf der
# AIService-Seite hinterlegt werden; ohne ihn beantwortet JARVIS-MCP jede Anfrage mit HTTP 401.
# Erzeugen z. B. mit:  openssl rand -hex 32
JARVIS_MCP_AUTH_TOKEN=bitte-aendern

# Long-Lived Access Token aus dem Home-Assistant-Profil (Benutzer → Sicherheit → ganz unten).
# Home Assistant verlangt ihn bei ausnahmslos jedem REST-Aufruf.
HA_TOKEN=bitte-aendern

# --- Optional; die Vorgabewerte passen fuer den Normalbetrieb ----------------------------------

# Home Assistant laeuft auf JARVIS im Host-Netz auf Port 8123 (kein Portmapping, siehe dessen
# Setup-Anleitung). Aus einem Bridge-Container heraus ist der Host so erreichbar.
#HA_BASE_URL=http://host.docker.internal:8123

# Takt, in dem der Entitaeten-Index im Hintergrund erneuert wird. Kuerzer heisst: neue Lichter und
# Routinen sind schneller ansprechbar; laenger heisst: weniger Last auf Home Assistant. Ein
# unbekannter Name loest ohnehin ein sofortiges Nachladen aus, gedeckelt auf einmal alle 5 s.
#HA_CACHE_TTL=60s

# Ports auf dem Host. Auf JARVIS sind bereits belegt: 8080 (SearXNG), 8081 (Filebrowser),
# 8082 (ALoveLetter), 8083 (DeploymentService), 8090/8092 (Monitoring Tool), 8091 (ntfy),
# 8093/8094 (JARVIS-Pilot), 8095/8097 (JARVIS-AIService), 8100 (ChromaDB), 8123 (Home Assistant)
# und 7000 (Odysseus). 8098/8099 schliessen an den Block der selbstgebauten JARVIS-Dienste an.
#
# Ohne Praefix bindet Docker an 0.0.0.0 - so gehoert es hier auch. Ein Praefix "127.0.0.1:" waere
# die naheliegende, aber falsche Vorsicht: Der Port waere dann weder ueber Tailscale erreichbar
# noch aus dem Monitoring-Backend-Container, der die Health-Pruefungen ausfuehrt. Dieselbe
# Entscheidung wie beim Health-Port des JARVIS-AIService (8097).
#MCP_PORT=8098
#HEALTH_PORT=8099

#JARVIS_MCP_LOG_LEVEL=INFO
#TZ=Europe/Berlin

# Bereiche, Lichter und Routinen kommen aus Home Assistant - hier ist dafuer nichts einzutragen.
# Diese Zeile braucht es nur im Ausnahmefall, dass ein Bereich anders angesprochen werden soll,
# als er in Home Assistant heisst (dessen eigene Bereichsaliasse gibt keine REST-Schnittstelle
# heraus). Meist ist es einfacher, den Bereich in Home Assistant gleich so zu nennen.
#SPRING_APPLICATION_JSON={"jarvis-mcp":{"home-assistant":{"areas":[{"id":"arbeitszimmer","names":["Büro"]}]}}}
